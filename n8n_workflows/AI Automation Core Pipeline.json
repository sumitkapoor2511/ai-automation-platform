        "url": "http://backend:8000/api/v1/tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('HTTP Request').item.json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $fromAI('title', 'Short descriptive title for the task', 'string') }}\",\n  \"agent_type\": \"{{ $fromAI('agent_type', 'Must be strictly RAG_Search or Data_Extraction', 'string') }}\",\n  \"priority\": {{ $fromAI('priority', 'Priority integer between 1 and 5', 'number') }},\n  \"payload_data\": {\n    \"created_by\": \"autonomous_n8n_agent\"\n  }\n}",
        "options": {}
